# ─── Frontend (Next.js) — .env.local ───────────────────────────────────────
# Uniquement des variables exposées au navigateur (NEXT_PUBLIC_*).

NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL publique HTTPS du frontend (Play Store, liens légaux, Capacitor)
# NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app

# E-mail de contact affiché sur les pages légales (Play Store)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Nom de l'éditeur (mentions légales, optionnel)
# NEXT_PUBLIC_LEGAL_PUBLISHER=

# Capacitor : URL chargée dans l'app Android (même que le frontend en prod)
# CAPACITOR_SERVER_URL=https://votre-app.vercel.app

UPLOADTHING_TOKEN=

# ─── Backend — backend/.env ─────────────────────────────────────────────────
# Voir backend/.env.example (JWT_SECRET, MongoDB, CinetPay, etc.)
