# ─── Frontend (Next.js) — .env.local (développement uniquement) ─────────────
# En production, les variables sont définies sur Vercel (ne pas modifier ici).

# Secret JWT — DOIT être le même que le backend Express (obligatoire)
# JWT_SECRET=change-me-to-a-long-random-string

# Dev + ngrok : proxy Next.js → Express local (voir next.config.js rewrites)
NEXT_PUBLIC_API_URL=/api

# Cible du proxy server-side (routes auth/register, auth/resend-code)
# DEV_BACKEND_URL=http://localhost:5000

# Production Vercel (exemple — configuré sur le dashboard Vercel, pas dans ce fichier) :
# NEXT_PUBLIC_API_URL=https://votre-backend.onrender.com/api

# URL publique HTTPS du frontend (Play Store, Capacitor)
# NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app

# E-mail de contact affiché sur les pages légales (Play Store)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Nom de l'éditeur (mentions légales, optionnel)
# NEXT_PUBLIC_LEGAL_PUBLISHER=

# Capacitor : URL chargée dans l'app Android (production)
# CAPACITOR_SERVER_URL=https://votre-app.vercel.app

# Google OAuth (mêmes valeurs que backend — Client ID Web)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optionnel : forcer l'origine de callback (sinon = URL courante / ngrok)
# GOOGLE_REDIRECT_ORIGIN=https://votre-tunnel.ngrok-free.app
# NEXT_PUBLIC_GOOGLE_REDIRECT_ORIGIN=https://votre-tunnel.ngrok-free.app

UPLOADTHING_TOKEN=

# ─── Backend Express — backend/.env (port 5000 en local) ───────────────────
# Voir backend/.env.example (JWT_SECRET, MongoDB, CinetPay, OpenRouter, etc.)
